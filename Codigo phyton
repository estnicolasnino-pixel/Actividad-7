import socket
import threading
import time
import random
import pybullet as p
import pybullet_data

# ==========================================
# 1. CONFIGURACIÓN DEL LABERINTO (NODOS)
# ==========================================
# Coordenadas 3D (X, Y, Z) para cada nodo del laberinto
NODES_POS = {
    0: [-2.0, -2.0, 0.2],
    1: [ 0.0, -2.0, 0.2],
    2: [ 2.0, -2.0, 0.2],
    3: [-2.0,  2.0, 0.2],
    4: [ 0.0,  2.0, 0.2],
    5: [ 2.0,  2.0, 0.2]
}

# ==========================================
# 2. INICIALIZACIÓN DE PYBULLET
# ==========================================
physicsClient = p.connect(p.GUI)
p.setAdditionalSearchPath(pybullet_data.getDataPath())
p.setGravity(0, 0, -9.81)
p.loadURDF("plane.urdf")

# Crear los 3 Carritos (Rojo: Robot 1, Verde: Robot 2, Azul: Robot 3)
colors = [
    [1, 0, 0, 1],  # Robot 1 (ESP32 Real) - Rojo
    [0, 1, 0, 1],  # Robot 2 (Virtual) - Verde
    [0, 0, 1, 1]   # Robot 3 (Virtual) - Azul
]

robots = {}

for r_id in [1, 2, 3]:
    start_pos = [NODES_POS[0][0] + (r_id * 0.25), NODES_POS[0][1], NODES_POS[0][2]]
    box_half = [0.15, 0.15, 0.1]
    col = p.createCollisionShape(p.GEOM_BOX, halfExtents=box_half)
    vis = p.createVisualShape(p.GEOM_BOX, halfExtents=box_half, rgbaColor=colors[r_id-1])
    robots[r_id] = p.createMultiBody(baseMass=1, baseCollisionShapeIndex=col,
                                     baseVisualShapeIndex=vis, basePosition=start_pos)

def mover_robot(r_id, node_id):
    """Mueve suavemente la posición del robot en PyBullet según el nodo actual."""
    if r_id in robots and node_id in NODES_POS:
        base = NODES_POS[node_id]
        offset_pos = [base[0] + (r_id * 0.25), base[1], base[2]]
        p.resetBasePositionAndOrientation(robots[r_id], offset_pos, [0, 0, 0, 1])

# ==========================================
# 3. SIMULACIÓN LOCAL PARA ROBOTS VIRTUALES (2 Y 3)
# ==========================================
def simular_robot_virtual(r_id):
    """Simula la navegación ACO de los robots 2 y 3 en hilos independientes."""
    rutas_ejemplo = [
        [0, 1, 2, 5],
        [0, 2, 4, 5],
        [0, 1, 3, 5]
    ]
    while True:
        ruta = random.choice(rutas_ejemplo)
        for nodo in ruta:
            mover_robot(r_id, nodo)
            time.sleep(1.0)
        time.sleep(2.0)

# Lanzar hilos para simular los carritos 2 y 3 en segundo plano
threading.Thread(target=simular_robot_virtual, args=(2,), daemon=True).start()
threading.Thread(target=simular_robot_virtual, args=(3,), daemon=True).start()

# ==========================================
# 4. RECEPTOR UDP PARA LA ESP32 REAL (ROBOT 1)
# ==========================================
UDP_IP = "0.0.0.0"
UDP_PORT = 8888

sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind((UDP_IP, UDP_PORT))
sock.setblocking(False)

print("=" * 60)
print(" Gemelo Digital Híbrido Activo")
print(f" Escuchando telemetría de la ESP32 (Robot 1) en el puerto UDP {UDP_PORT}...")
print("=" * 60)

# ==========================================
# 5. BUCLE PRINCIPAL DE SIMULACIÓN
# ==========================================
try:
    while True:
        p.stepSimulation()
        try:
            data, addr = sock.recvfrom(1024)
            msg = data.decode('utf-8').strip()
            
            # Formato de paquete esperado: POS,Robot_ID,Node_ID (Ejemplo: POS,1,3)
            if msg.startswith("POS"):
                parts = msg.split(",")
                if len(parts) == 3:
                    r_id = int(parts[1])
                    node_id = int(parts[2])
                    
                    if r_id == 1:
                        mover_robot(1, node_id)
                        print(f"📡 [ESP32 Real] Robot 1 avanzado al Nodo {node_id}")
        except socket.error:
            pass
        
        time.sleep(0.02)

except KeyboardInterrupt:
    p.disconnect()
    print("\nSimulación finalizada.")
